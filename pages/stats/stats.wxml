<view class="page {{themeClass}}">
  <view class="range-bar">
    <view class="range-nav" bindtap="shiftRange" data-dir="-1">‹</view>
    <view class="range-title" bindtap="openPicker">{{title}}</view>
    <view class="range-nav" bindtap="shiftRange" data-dir="1">›</view>
  </view>

  <view class="summary-strip metric-strip">
    <view class="summary-item metric-item {{metric === 'expense' ? 'active' : ''}}" bindtap="onMetric" data-metric="expense">
      <text class="summary-label">支出</text>
      <text class="summary-value">¥{{summary.expenseText}}</text>
    </view>
    <view class="summary-item metric-item {{metric === 'income' ? 'active' : ''}}" bindtap="onMetric" data-metric="income">
      <text class="summary-label">收入</text>
      <text class="summary-value">¥{{summary.incomeText}}</text>
    </view>
    <view class="summary-item metric-item {{metric === 'balance' ? 'active' : ''}}" bindtap="onMetric" data-metric="balance">
      <text class="summary-label">结余</text>
      <text class="summary-value">¥{{summary.balanceText}}</text>
    </view>
  </view>

  <view class="card chart-card">
    <view class="card-title">{{pieTitle}}</view>
    <image class="chart-canvas" src="{{pie.img}}" mode="aspectFit"></image>
    <view wx:if="{{pie.items.length === 0}}" class="empty-sub">暂无数据</view>
    <view wx:for="{{pie.items}}" wx:key="name" class="legend-row">
      <view class="legend-icon">
        <image wx:if="{{item.iconType === 'image'}}" class="legend-icon-img" src="{{item.icon}}" mode="aspectFit"></image>
        <text wx:else>{{item.icon}}</text>
      </view>
      <view class="legend-name">{{item.name}}</view>
      <view class="legend-bar">
        <view class="legend-fill" style="width: {{item.percent}}%; background: {{item.color}}"></view>
      </view>
      <view class="legend-right">{{item.percent}}% · ¥{{item.amountText}}</view>
    </view>
  </view>

  <view class="card chart-card">
    <view class="card-title">{{barTitle}}</view>
    <view class="bar-chart-wrap">
      <image class="chart-canvas" src="{{bar.img}}" mode="aspectFit"></image>
      <view class="bar-touch-layer" bindtouchstart="onBarTouch"></view>
    </view>
    <view wx:if="{{bar.selectedIndex >= 0}}" class="bar-selected">{{bar.selectedText}}</view>
    <view class="bar-average">
      <text class="bar-average-item">日均支出 ¥{{bar.daily.expense}}</text>
      <text class="bar-average-item">日均收入 ¥{{bar.daily.income}}</text>
      <text class="bar-average-item">日均结余 ¥{{bar.daily.balance}}</text>
    </view>
    <view wx:if="{{!bar.hasData}}" class="empty-sub">暂无数据</view>
  </view>

  <view class="card chart-card">
    <view class="card-title">{{lineTitle}}</view>
    <view class="legend-tags" wx:if="{{themeClass !== 'theme-2'}}">
      <view class="tag" style="color: {{line.color}}">{{line.tagText}}</view>
    </view>
    <image class="chart-canvas" src="{{line.img}}" mode="aspectFit"></image>
    <view wx:if="{{!line.hasData}}" class="empty-sub">暂无数据</view>
  </view>

  <view class="mask" wx:if="{{picker.show && !picker.customCalOpen}}" bindtap="closePicker" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">选择查看区间</view>
      <view class="mode-tabs">
        <view class="mode-tab {{picker.mode === 'month' ? 'active' : ''}}" data-mode="month" bindtap="onPickMode">月</view>
        <view class="mode-tab {{picker.mode === 'week' ? 'active' : ''}}" data-mode="week" bindtap="onPickMode">周</view>
        <view class="mode-tab {{picker.mode === 'year' ? 'active' : ''}}" data-mode="year" bindtap="onPickMode">年</view>
        <view class="mode-tab {{picker.mode === 'custom' ? 'active' : ''}}" data-mode="custom" bindtap="onPickMode">自定义</view>
      </view>

      <scroll-view scroll-y class="sheet-body" wx:if="{{picker.mode !== 'year'}}">
        <block wx:if="{{picker.mode === 'month' || picker.mode === 'week'}}">
          <view class="cal-head">
            <view class="cal-nav" bindtap="calShift" data-dir="-1">‹</view>
            <view class="cal-title">{{picker.calTitle}}</view>
            <view class="cal-nav" bindtap="calShift" data-dir="1">›</view>
          </view>
          <view class="cal-week">
            <text wx:for="{{calWeek}}" wx:key="*this" class="cal-week-cell">{{item}}</text>
          </view>
          <view class="cal-grid">
            <view wx:for="{{picker.calCells}}" wx:key="key" class="cal-cell {{item.day ? 'day' : 'blank'}} {{item.state}}" bindtap="onPickDay" data-date="{{item.value}}">{{item.day}}</view>
          </view>
        </block>

        <block wx:if="{{picker.mode === 'custom'}}">
          <view class="picker-row custom-target {{picker.customTarget === 'start' ? 'active' : ''}}" bindtap="onCustomTarget" data-target="start">开始：{{picker.start}} <text class="picker-hint">选择</text></view>
          <view class="picker-row custom-target {{picker.customTarget === 'end' ? 'active' : ''}}" bindtap="onCustomTarget" data-target="end">结束：{{picker.end}} <text class="picker-hint">选择</text></view>
        </block>
      </scroll-view>

      <block wx:if="{{picker.mode === 'year'}}">
        <view class="year-wheel-wrap">
          <scroll-view scroll-y enhanced class="year-scroll" scroll-into-view="{{picker.scrollInto}}" scroll-with-animation show-scrollbar="{{false}}" bindscroll="onYearScroll" bindscrollend="onYearScrollEnd">
            <view class="year-scroll-pad"></view>
            <view wx:for="{{picker.years}}" wx:key="*this" id="year-{{item}}" class="year-scroll-item {{picker.year === item ? 'active' : ''}}" bindtap="onYearTap" data-year="{{item}}">{{item}}</view>
            <view class="year-scroll-pad"></view>
          </scroll-view>
        </view>
      </block>

      <view class="sheet-actions">
        <view class="btn btn-cancel" bindtap="closePicker">取消</view>
        <view class="btn btn-ok" bindtap="applyPicker">完成</view>
      </view>
    </view>
  </view>

  <view class="mask" wx:if="{{picker.show && picker.customCalOpen}}" bindtap="closeCustomCal" catchtouchmove="noop">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{picker.customTarget === 'start' ? '选择开始日期' : '选择结束日期'}}</view>
      <scroll-view scroll-y class="sheet-body">
        <view class="cal-head">
          <view class="cal-nav" bindtap="calShift" data-dir="-1">‹</view>
          <view class="cal-title">{{picker.customTarget === 'start' ? picker.startCal.title : picker.endCal.title}}</view>
          <view class="cal-nav" bindtap="calShift" data-dir="1">›</view>
        </view>
        <view class="cal-week">
          <text wx:for="{{calWeek}}" wx:key="*this" class="cal-week-cell">{{item}}</text>
        </view>
        <view class="cal-grid">
          <view wx:for="{{picker.customTarget === 'start' ? picker.startCal.cells : picker.endCal.cells}}" wx:key="key" class="cal-cell {{item.day ? 'day' : 'blank'}} {{item.state}}" bindtap="onPickDay" data-date="{{item.value}}">{{item.day}}</view>
        </view>
      </scroll-view>
      <view class="sheet-actions">
        <view class="btn btn-cancel" bindtap="closeCustomCal">取消</view>
        <view class="btn btn-ok" bindtap="confirmCustomCal">确定</view>
      </view>
    </view>
  </view>

  <canvas type="2d" id="pieCanvas" class="chart-source"></canvas>
  <canvas type="2d" id="barCanvas" class="chart-source bar-source"></canvas>
  <canvas type="2d" id="lineCanvas" class="chart-source"></canvas>
</view>
