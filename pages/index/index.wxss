.hero {
  background: linear-gradient(165deg, #FDF7EB 0%, #F3E3C8 100%);
  border: 1rpx solid #E2CFA9;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow:
    -2rpx -2rpx 6rpx rgba(255, 255, 255, 0.55),
    3rpx 4rpx 12rpx rgba(93, 64, 55, 0.14);
}

.hero-date {
  background: linear-gradient(135deg, #7A563E 0%, #5D4037 55%, #4A322A 100%);
  color: #FFF4E2;
  font-family: Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-weight: 700;
  font-size: 26rpx;
  text-align: center;
  padding: 18rpx 0;
  border-bottom: 3rpx solid #3E2A1F;
  box-shadow: 0 2rpx 4rpx rgba(46, 33, 25, 0.35);
}

.hero-row {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx 34rpx;
}

.hero-item {
  flex: 1;
}

.hero-label {
  font-size: 24rpx;
  color: #8D7B63;
}

.hero-amount {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  margin-top: 8rpx;
  color: #4E342E;
  font-family: 'DIN Alternate', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-style: normal;
  font-variant-numeric: tabular-nums;
}

.hero-divider {
  width: 2rpx;
  height: 76rpx;
  background: linear-gradient(180deg, transparent, #C9B084 50%, transparent);
  margin: 0 24rpx;
}

.type-switch {
  display: flex;
  background: #EADDC4;
  border: 1rpx solid #D5C09B;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(93, 64, 55, 0.16);
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 10rpx;
  color: #5F5242;
  font-size: 28rpx;
  background: linear-gradient(165deg, #FBF3E3 0%, #F0E0C2 100%);
  border: 1rpx solid #E0CBA4;
  box-shadow: 1rpx 2rpx 3rpx rgba(93, 64, 55, 0.16);
}

.type-item.active {
  background: linear-gradient(135deg, #7A563E 0%, #5D4037 58%, #4A322A 100%);
  color: #FFF8EC;
  font-weight: 600;
  border-color: #3E2A1F;
  box-shadow: 1rpx 3rpx 6rpx rgba(46, 33, 25, 0.35);
}

.amount-row {
  flex: 1;
  display: flex;
  align-items: center;
}

.amount-prefix {
  font-size: 36rpx;
  color: #4E342E;
  margin-right: 10rpx;
  font-family: 'DIN Alternate', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

.amount-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 600;
  font-family: 'DIN Alternate', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-style: normal;
  font-variant-numeric: tabular-nums;
  color: #4E342E;
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 0;
}

.amount-placeholder {
  color: #C1AC8A;
  font-weight: 400;
  font-family: 'DIN Alternate', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-style: normal;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4E342E;
  margin-bottom: 20rpx;
  font-family: Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.cat-field {
  position: relative;
}

.cat-current {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.cat-current-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.cat-current-icon.img {
  width: 48rpx;
  height: 48rpx;
}

.cat-current-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #4E342E;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cat-arrow {
  font-size: 20rpx;
  color: #8D7B63;
  margin-left: 12rpx;
}

.cat-panel {
  margin: 8rpx -8rpx 16rpx;
  padding: 20rpx 12rpx 12rpx;
  border-top: 2rpx dashed #D9C59E;
  background: rgba(93, 64, 55, 0.04);
  border-radius: 12rpx;
}

.cat-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.cat-tile {
  width: 25%;
  box-sizing: border-box;
  padding: 8rpx;
  position: relative;
}

.cat-del {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #5D4037;
  color: #FFF6E6;
  font-size: 26rpx;
  line-height: 32rpx;
  text-align: center;
  z-index: 2;
  border: 2rpx solid #FFF6E6;
  box-shadow: 0 2rpx 5rpx rgba(46, 33, 25, 0.3);
}

.cat-del:active {
  transform: scale(0.92);
}

.cat-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 16rpx;
  border-radius: 18rpx;
  background: linear-gradient(165deg, #FFF9EC 0%, #EFE2C6 100%);
  border: 1rpx solid #E0CBA4;
  box-shadow:
    1rpx 2rpx 5rpx rgba(93, 64, 55, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  min-height: 148rpx;
  box-sizing: border-box;
}

.cat-tile.active .cat-inner {
  background: linear-gradient(135deg, #7A563E 0%, #5D4037 60%, #4A322A 100%);
  border-color: #3E2A1F;
  box-shadow: 1rpx 3rpx 6rpx rgba(46, 33, 25, 0.35);
}

.cat-tile.active .cat-name {
  color: #FFF6E6;
  font-weight: 600;
}

.cat-icon {
  font-size: 52rpx;
  line-height: 1.2;
}

.cat-icon.img {
  width: 56rpx;
  height: 56rpx;
}

.cat-name {
  font-size: 22rpx;
  color: #6B5B49;
  margin-top: 10rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add .cat-icon {
  font-size: 52rpx;
  color: #8D6E63;
  font-weight: 400;
}

.field {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx dashed #D9C59E;
}

.field:last-of-type {
  border-bottom: none;
}

.label {
  width: 120rpx;
  color: #6D5B47;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #4E342E;
  background: #F1E5CD;
  border: 1rpx solid #DCC49E;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  box-shadow: inset 1rpx 2rpx 4rpx rgba(93, 64, 55, 0.12);
}

.picker-value {
  flex: 1;
  font-size: 30rpx;
  color: #4E342E;
  font-weight: 600;
}

.save-btn {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #7A563E 0%, #5D4037 55%, #4A322A 100%);
  color: #FFF4E2;
  border-radius: 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: 1rpx solid #3E2A1F;
  box-shadow: 0 5rpx 0 #3E2A1F, 0 8rpx 12rpx rgba(46, 33, 25, 0.28);
}

.save-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 1rpx 0 #3E2A1F, 0 3rpx 6rpx rgba(46, 33, 25, 0.2);
}

.save-btn::after {
  border: none;
}

.custom-name {
  background: #F1E5CD;
  border: 1rpx solid #DCC49E;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: #4E342E;
  box-shadow: inset 1rpx 2rpx 4rpx rgba(93, 64, 55, 0.12);
}

.custom-sheet-body {
  height: auto;
  max-height: none;
  flex: none;
}

.modal-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #6D5B47;
  margin-bottom: 16rpx;
}

.upload-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.upload-btn {
  background: linear-gradient(165deg, #FBF3E3 0%, #F0E0C2 100%);
  border: 1rpx solid #E0CBA4;
  color: #5F5242;
  font-size: 28rpx;
  padding: 20rpx 32rpx;
  border-radius: 12rpx;
  box-shadow: 1rpx 2rpx 4rpx rgba(93, 64, 55, 0.16);
}

.upload-preview {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #F1E5CD;
  border: 1rpx solid #DCC49E;
  margin-left: 20rpx;
}

.theme-2 .hero {
  background: linear-gradient(165deg, #FFFFFF 0%, #F4F7FF 100%);
  border-color: #E4E8F2;
  box-shadow:
    0 6rpx 16rpx rgba(65, 105, 225, 0.10);
}

.theme-2 .hero-date {
  background: linear-gradient(135deg, #4169E1 0%, #3155C7 55%, #274A9E 100%);
  border-bottom: 3rpx solid #24459A;
  box-shadow: 0 2rpx 4rpx rgba(65, 105, 225, 0.30);
}

.theme-2 .hero-label {
  color: #9E9E9E;
}

.theme-2 .hero-amount {
  color: #263238;
}

.theme-2 .hero-divider {
  background: linear-gradient(180deg, transparent, #E0E0E0 50%, transparent);
}

.theme-2 .type-switch {
  background: #F2F2F2;
  border-color: #E2E2E2;
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.theme-2 .type-item {
  background: linear-gradient(165deg, #FFFFFF 0%, #FAFAFA 100%);
  border-color: #E5E5E5;
  color: #616161;
  box-shadow: 1rpx 2rpx 3rpx rgba(0, 0, 0, 0.08);
}

.theme-2 .type-item.active {
  background: linear-gradient(135deg, #4169E1 0%, #3155C7 60%, #274A9E 100%);
  color: #FFFFFF;
  border-color: #24459A;
  box-shadow: 1rpx 3rpx 8rpx rgba(65, 105, 225, 0.35);
}

.theme-2 .amount-prefix {
  color: #424242;
}

.theme-2 .amount-input {
  color: #1F2D3D;
}

.theme-2 .amount-placeholder {
  color: #BDBDBD;
}

.theme-2 .cat-panel {
  border-top-color: #E0E0E0;
  background: rgba(0, 0, 0, 0.03);
}

.theme-2 .cat-del {
  background: #4169E1;
  color: #FFFFFF;
  border-color: #FFFFFF;
  box-shadow: 0 2rpx 5rpx rgba(65, 105, 225, 0.32);
}

.theme-2 .cat-inner {
  background: linear-gradient(165deg, #FFFFFF 0%, #F7F7F7 100%);
  border-color: #E0E0E0;
  box-shadow:
    1rpx 2rpx 5rpx rgba(0, 0, 0, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.theme-2 .cat-tile.active .cat-inner {
  background: linear-gradient(135deg, #4169E1 0%, #3155C7 60%, #274A9E 100%);
  border-color: #24459A;
  box-shadow: 1rpx 3rpx 8rpx rgba(65, 105, 225, 0.35);
}

.theme-2 .cat-icon {
  color: #263238;
}

.theme-2 .cat-name {
  color: #616161;
}

.theme-2 .cat-tile.active .cat-name {
  color: #FFFFFF;
}

.theme-2 .add .cat-icon {
  color: #4169E1;
}

.theme-2 .field {
  border-bottom-color: #E8E8E8;
}

.theme-2 .label {
  color: #616161;
}

.theme-2 .input {
  background: #FFFFFF;
  border-color: #DADADA;
  color: #263238;
  box-shadow: inset 1rpx 2rpx 4rpx rgba(0, 0, 0, 0.06);
}

.theme-2 .picker-value {
  color: #263238;
}

.theme-2 .save-btn {
  background: linear-gradient(135deg, #4169E1 0%, #3155C7 55%, #274A9E 100%);
  color: #FFFFFF;
  border: 1rpx solid #24459A;
  box-shadow: 0 5rpx 0 #24459A, 0 8rpx 12rpx rgba(65, 105, 225, 0.30);
}

.theme-2 .save-btn:active {
  box-shadow: 0 1rpx 0 #24459A, 0 3rpx 6rpx rgba(65, 105, 225, 0.22);
}

.theme-2 .custom-name {
  background: #FFFFFF;
  border-color: #DADADA;
  color: #263238;
  box-shadow: inset 1rpx 2rpx 4rpx rgba(0, 0, 0, 0.06);
}

.theme-2 .modal-section-title {
  color: #616161;
}
