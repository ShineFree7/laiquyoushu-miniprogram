page {
  background: #F5E9D6;
  color: #424242;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  padding: 24rpx 24rpx 220rpx;
}

.card {
  background: linear-gradient(165deg, #FDF7EB 0%, #F3E3C8 100%);
  border: 1rpx solid #E2CFA9;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow:
    -2rpx -2rpx 6rpx rgba(255, 255, 255, 0.55),
    3rpx 4rpx 10rpx rgba(93, 64, 55, 0.12);
}

.tips {
  color: #8D7B63;
  font-size: 24rpx;
  text-align: center;
  margin-top: 8rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #8D7B63;
}

.empty-title {
  font-family: Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 32rpx;
  font-weight: 700;
  color: #5D4037;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #8D7B63;
}

.range-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(165deg, #FDF7EB 0%, #F3E3C8 100%);
  border: 1rpx solid #E2CFA9;
  border-radius: 16rpx;
  padding: 12rpx 8rpx;
  margin-bottom: 16rpx;
  box-shadow:
    -2rpx -2rpx 6rpx rgba(255, 255, 255, 0.55),
    3rpx 4rpx 10rpx rgba(93, 64, 55, 0.12);
}

.range-nav {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-family: Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #5F5242;
  flex-shrink: 0;
}

.range-nav:active {
  opacity: 0.55;
}

.range-title {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  font-weight: 700;
  color: #4E342E;
  padding: 10rpx 0;
  font-family: Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.summary-strip {
  display: flex;
  background: linear-gradient(165deg, #FDF7EB 0%, #F3E3C8 100%);
  border: 1rpx solid #E2CFA9;
  border-radius: 16rpx;
  padding: 22rpx 12rpx;
  margin-bottom: 24rpx;
  box-shadow:
    -2rpx -2rpx 6rpx rgba(255, 255, 255, 0.55),
    3rpx 4rpx 10rpx rgba(93, 64, 55, 0.12);
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-label {
  display: block;
  font-size: 22rpx;
  color: #8D7B63;
}

.summary-value {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 6rpx;
  font-family: 'DIN Alternate', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-style: normal;
  font-variant-numeric: tabular-nums;
}

.expense {
  color: #4E342E;
}

.income {
  color: #4E342E;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(58, 42, 32, 0.55);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: linear-gradient(170deg, #FDF7EB 0%, #F2E2C5 100%);
  border-top: 3rpx solid #D9C094;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx 28rpx 40rpx;
  box-sizing: border-box;
  max-height: 92vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -8rpx 24rpx rgba(46, 33, 25, 0.24);
}

.sheet-body {
  flex: 1 1 auto;
  height: 42vh;
  max-height: 50vh;
  min-height: 0;
}

.sheet-title {
  flex-shrink: 0;
  font-family: Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  color: #4E342E;
  margin-bottom: 28rpx;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.mode-tabs {
  display: flex;
  background: #EADDC4;
  border: 1rpx solid #D5C09B;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(93, 64, 55, 0.16);
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 10rpx;
  color: #5F5242;
  font-size: 26rpx;
  background: linear-gradient(165deg, #FBF3E3 0%, #F0E0C2 100%);
  border: 1rpx solid #E0CBA4;
  box-shadow: 1rpx 2rpx 3rpx rgba(93, 64, 55, 0.16);
}

.mode-tab.active {
  background: linear-gradient(135deg, #7A563E 0%, #5D4037 58%, #4A322A 100%);
  color: #FFF8EC;
  font-weight: 600;
  border-color: #3E2A1F;
  box-shadow: 1rpx 3rpx 6rpx rgba(46, 33, 25, 0.35);
}

.picker-row {
  background: #F1E5CD;
  border: 1rpx solid #DCC49E;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #4E342E;
  box-shadow: inset 1rpx 2rpx 4rpx rgba(93, 64, 55, 0.12);
}

.picker-row.custom-target {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-row.custom-target.active {
  border-color: #C49B6A;
  box-shadow: inset 0 0 0 2rpx rgba(125, 95, 66, 0.18);
}

.picker-hint {
  font-size: 24rpx;
  color: #8D7B63;
}

.year-wheel-wrap {
  padding: 8rpx 24rpx 24rpx;
}

.year-scroll {
  height: 220px;
  background: #F1E5CD;
  border: 1rpx solid #DCC49E;
  border-radius: 14rpx;
}

.year-scroll-pad {
  height: 88px;
}

.year-scroll-item {
  height: 44px;
  line-height: 44px;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #4E342E;
}

.year-scroll-item.active {
  color: #5D4037;
  background: rgba(93, 64, 55, 0.08);
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cal-nav {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-family: Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #5F5242;
  border-radius: 50%;
  background: linear-gradient(165deg, #FBF3E3 0%, #F0E0C2 100%);
  border: 1rpx solid #E0CBA4;
  box-shadow: 1rpx 2rpx 3rpx rgba(93, 64, 55, 0.16);
}

.cal-title {
  font-size: 30rpx;
  font-weight: 700;
  font-family: Helvetica, Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  color: #4E342E;
}

.cal-week {
  display: flex;
}

.cal-week-cell {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #8D7B63;
  padding: 10rpx 0;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.2857%;
  box-sizing: border-box;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #4E342E;
  border-radius: 12rpx;
}

.cal-cell.selected {
  background: linear-gradient(135deg, #7A563E 0%, #5D4037 58%, #4A322A 100%);
  color: #FFF8EC;
  font-weight: 600;
  border: 1rpx solid #3E2A1F;
  box-shadow: 1rpx 3rpx 6rpx rgba(46, 33, 25, 0.35);
}

.cal-cell.in {
  background: #EADFC9;
  color: #5D4037;
  border: 1rpx solid #D9C59E;
}

.cal-cell.blank {
  visibility: hidden;
}

.sheet-actions {
  display: flex;
  margin-top: 28rpx;
  flex-shrink: 0;
  padding-top: 24rpx;
  border-top: 2rpx dashed #D9C59E;
  position: relative;
  z-index: 20;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn:active {
  transform: translateY(2rpx);
}

.btn-cancel {
  background: linear-gradient(165deg, #FBF3E3 0%, #F0E0C2 100%);
  border: 1rpx solid #E0CBA4;
  color: #5F5242;
  margin-right: 20rpx;
  box-shadow: 1rpx 2rpx 4rpx rgba(93, 64, 55, 0.18);
}

.btn-ok {
  background: linear-gradient(135deg, #7A563E 0%, #5D4037 58%, #4A322A 100%);
  border: 1rpx solid #3E2A1F;
  color: #FFF8EC;
  font-weight: 600;
  box-shadow: 0 4rpx 0 #3E2A1F, 0 6rpx 10rpx rgba(46, 33, 25, 0.28);
}

.btn-ok:active {
  box-shadow: 0 1rpx 0 #3E2A1F, 0 3rpx 6rpx rgba(46, 33, 25, 0.2);
}

/* 主题2：皇家蓝 · 白底灰框 */
.theme-2 {
  background: #FFFFFF;
  min-height: 100vh;
}

.theme-2 .card {
  background: #FFFFFF;
  border-color: #E8E8EA;
  box-shadow:
    0 6rpx 18rpx rgba(31, 45, 61, 0.06);
  border-radius: 20rpx;
}

.theme-2 .tips {
  color: #9E9E9E;
}

.theme-2 .empty-title {
  color: #1F2D3D;
}

.theme-2 .empty-sub {
  color: #9E9E9E;
}

.theme-2 .range-bar {
  background: #FFFFFF;
  border-color: #E8E8EA;
  box-shadow:
    0 4rpx 14rpx rgba(31, 45, 61, 0.05);
  border-radius: 18rpx;
}

.theme-2 .range-nav {
  color: #4169E1;
}

.theme-2 .range-title {
  color: #1F2D3D;
}

.theme-2 .summary-strip {
  background: #FFFFFF;
  border-color: #E8E8EA;
  box-shadow:
    0 4rpx 14rpx rgba(31, 45, 61, 0.05);
  border-radius: 18rpx;
}

.theme-2 .summary-label {
  color: #7B89A3;
}

.theme-2 .summary-value {
  color: #1F2D3D;
}

.theme-2 .sheet {
  background: #FFFFFF;
  border-top: 3rpx solid #E8E8EA;
}

.theme-2 .sheet-title {
  color: #1F2D3D;
  text-shadow: none;
}

.theme-2 .mode-tabs {
  background: #F2F5FC;
  border-color: #E4E8F2;
  box-shadow: inset 0 2rpx 6rpx rgba(31, 45, 61, 0.04);
}

.theme-2 .mode-tab {
  background: #FFFFFF;
  border-color: #E8E8EA;
  color: #5D6B82;
  box-shadow: 0 2rpx 4rpx rgba(31, 45, 61, 0.05);
}

.theme-2 .mode-tab.active {
  background: linear-gradient(135deg, #4169E1 0%, #3155C7 60%, #274A9E 100%);
  border-color: #24459A;
  color: #FFFFFF;
  box-shadow: 0 4rpx 10rpx rgba(65, 105, 225, 0.32);
}

.theme-2 .picker-row {
  background: #FFFFFF;
  border-color: #E4E8F2;
  color: #1F2D3D;
  box-shadow: inset 1rpx 2rpx 4rpx rgba(31, 45, 61, 0.04);
}

.theme-2 .picker-row.custom-target.active {
  border-color: #4169E1;
  box-shadow: inset 0 0 0 2rpx rgba(65, 105, 225, 0.18);
}

.theme-2 .picker-hint {
  color: #7B89A3;
}

.theme-2 .year-scroll {
  background: #FFFFFF;
  border-color: #E4E8F2;
  box-shadow: 0 2rpx 8rpx rgba(31, 45, 61, 0.06);
}

.theme-2 .year-scroll-item {
  color: #1F2D3D;
}

.theme-2 .year-scroll-item.active {
  color: #4169E1;
  background: rgba(65, 105, 225, 0.08);
}

.theme-2 .cal-nav {
  background: #F5F7FC;
  border-color: #E4E8F2;
  color: #4169E1;
  box-shadow: 0 2rpx 6rpx rgba(31, 45, 61, 0.06);
}

.theme-2 .cal-title {
  color: #1F2D3D;
}

.theme-2 .cal-week-cell {
  color: #7B89A3;
}

.theme-2 .cal-cell {
  color: #263447;
}

.theme-2 .cal-cell.selected {
  background: linear-gradient(135deg, #4169E1 0%, #3155C7 60%, #274A9E 100%);
  color: #FFFFFF;
  border: 1rpx solid #24459A;
  box-shadow: 0 4rpx 10rpx rgba(65, 105, 225, 0.32);
}

.theme-2 .cal-cell.in {
  background: #EDF2FF;
  color: #4169E1;
  border: 1rpx solid #DCE6FF;
}

.theme-2 .sheet-actions {
  border-top-color: #EEF0F5;
}

.theme-2 .btn {
  color: #1F2D3D;
}

.theme-2 .btn-cancel {
  background: #F5F7FC;
  border-color: #E4E8F2;
  color: #5D6B82;
  box-shadow: 0 2rpx 6rpx rgba(31, 45, 61, 0.06);
}

.theme-2 .btn-ok {
  background: linear-gradient(135deg, #4169E1 0%, #3155C7 58%, #274A9E 100%);
  border-color: #24459A;
  color: #FFFFFF;
  box-shadow: 0 4rpx 0 #24459A, 0 6rpx 12rpx rgba(65, 105, 225, 0.30);
}

.theme-2 .btn-ok:active {
  box-shadow: 0 1rpx 0 #24459A, 0 3rpx 8rpx rgba(65, 105, 225, 0.24);
}

.theme-2 .income {
  color: #1F2D3D;
}

.theme-2 .expense {
  color: #1F2D3D;
}
